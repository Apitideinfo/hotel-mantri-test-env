# ==============================================================================
# HOTEL MANTRI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - This template contains ONLY placeholders. Never commit actual secret values.
# - Copy this file to `.env` for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Infrastructure (Required)
# ------------------------------------------------------------------------------
# Public Supabase URL (accessible from frontend and backend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Anonymous Key (safe for browser; guarded by Row Level Security)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Privileged Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND)
# Used by authoritative background services, migrations, and server cron jobs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 2. Razorpay Payment Gateway (Phase 1A Remediation)
# ------------------------------------------------------------------------------
# Public Razorpay Key ID (used by frontend SDK checkout modal)
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_public_key_id_here

# Razorpay Key Secret (SERVER-SIDE ONLY — NEVER EXPOSE TO FRONTEND)
# Used for HMAC-SHA256 signature verification and order creation.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ------------------------------------------------------------------------------
# 3. Server Runtime & Network
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
API_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000
# Comma-separated list of additional allowed CORS origins (SEC-07 explicit allowlist)
# ALLOWED_ORIGINS=https://hotelmantri.com,https://www.hotelmantri.com,https://hotel-mantri-test-env.vercel.app

# ------------------------------------------------------------------------------
# 4. Cron & Task Scheduling (Server-side)
# ------------------------------------------------------------------------------
# Secret token required to trigger automated WhatsApp summary cron jobs
CRON_SECRET=your_secure_cron_secret_here

# ------------------------------------------------------------------------------
# 5. SMTP / Email Notifications (Server-side)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@domain.com
SMTP_FROM_NAME="Hotel Mantri"
SMTP_SECURE=false

# ------------------------------------------------------------------------------
# 6. Whinta WhatsApp Official Integration & Cron Auth (Server-side Only)
# ------------------------------------------------------------------------------
# Whinta API Bearer Token (SERVER-SIDE ONLY — NEVER EXPOSE TO VITE_ FRONTEND)
# Supports both WHINTA_API_TOKEN and WHINTA_ACCESS_TOKEN
WHINTA_API_TOKEN=your_whinta_api_token_here
WHINTA_ACCESS_TOKEN=your_whinta_api_token_here
WHINTA_API_BASE_URL=https://app.whinta.com
WHINTA_ENABLED=true
WHINTA_DEFAULT_COUNTRY_CODE=91
WHINTA_WEBHOOK_SECRET=your_whinta_webhook_signing_secret_here

# Whinta Template Names & Language (Approved in Meta/Whinta dashboard)
WHINTA_RESERVATION_TEMPLATE=booking_confirmation
WHATSAPP_CONFIRMATION_TEMPLATE=booking_confirmation
WHINTA_DAILY_REPORT_TEMPLATE=daily_hotel_report
WHATSAPP_DAILY_REPORT_TEMPLATE=daily_hotel_report
WHATSAPP_TEMPLATE_LANGUAGE=en

# Storage Configuration for Dynamic PDF Documents
# Private Supabase Storage bucket for storing dynamic reservation & daily report PDFs
SUPABASE_DOCUMENTS_BUCKET=hotel-documents

# Cron Secret for Vercel Cron authentication (fail-closed security)
# Required by /api/cron/whinta-daily-report (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=your_long_random_cron_secret_here

# ------------------------------------------------------------------------------
# 7. Channel Manager Integrations (Server-side)
# ------------------------------------------------------------------------------
AIOSELL_BASE_URL=https://api.aiosell.com
AIOSELL_USERNAME=your_aiosell_username_here
AIOSELL_PASSWORD=your_aiosell_password_here
AIOSELL_WEBHOOK_ENABLED=false
AIOSELL_WEBHOOK_USERNAME=your_aiosell_webhook_user_here
AIOSELL_WEBHOOK_PASSWORD=your_aiosell_webhook_password_here

# ------------------------------------------------------------------------------
# 8. Chatbot API & n8n Cloud Integration
# ------------------------------------------------------------------------------
N8N_API_TOKEN=your_secure_random_n8n_api_token_here
N8N_PAYMENT_WEBHOOK_URL=https://your-workspace.app.n8n.cloud/webhook/hotelmantri-payment-confirmed
N8N_WEBHOOK_SECRET=your_secure_n8n_webhook_signing_secret_here
