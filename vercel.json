{
  "version": 2,
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-report",
      "schedule": "30 16 * * *"
    },
    {
      "path": "/api/notifications/whatsapp/cron?type=morning",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/notifications/whatsapp/cron?type=evening",
      "schedule": "30 16 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/Test/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/Test/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/test/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/test/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
