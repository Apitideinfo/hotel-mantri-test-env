# ==============================================================================
# HOTEL MANTRI — CHATBOT BOOKING API ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT:
# - This template contains ONLY placeholders. Never commit actual secret values.
# - Copy this file to `.env` in the `chatbot-booking-api/` directory for local runtime.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Runtime Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5050
PUBLIC_API_BASE_URL=http://localhost:5050

# ------------------------------------------------------------------------------
# 2. Shared Supabase PostgreSQL Infrastructure (Fail-Closed)
# ------------------------------------------------------------------------------
# Supabase project URL (must match the primary Hotel Mantri database)
SUPABASE_URL=https://your-project-ref.supabase.co

# Privileged Supabase Service-Role Key (SERVER-SIDE ONLY — NEVER EXPOSE)
# Used for authoritative database-level inventory holds, RPCs, and settlement.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ------------------------------------------------------------------------------
# 3. Single-Hotel Deployment Tenant Configuration
# ------------------------------------------------------------------------------
# Stable UUID of the single hotel property served by this deployment.
# Must point to an active, valid hotel in the hotels table.
HOTEL_ID=bd8f18de-2f97-48e7-b029-d2e536feb7cb

# Optional public slug identifier for human-readable external chatbot configuration
HOTEL_PUBLIC_SLUG=hotel-gopal

# ------------------------------------------------------------------------------
# 4. Razorpay Payment Gateway Configuration
# ------------------------------------------------------------------------------
# Razorpay Key ID (public key safe to return in payment options)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret (SERVER-SIDE ONLY — NEVER EXPOSE)
# Used for HMAC signature verification and order creation.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Dedicated Razorpay Webhook Signing Secret (Configured in Razorpay Webhook Dashboard)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# 5. Security, Tokens & Idempotency
# ------------------------------------------------------------------------------
# Dedicated secret for HMAC-SHA256 signing of server quotes and guest lookup tokens
# Must be at least 32 characters in production.
BOOKING_TOKEN_SECRET=your_cryptographically_secure_random_token_secret_min_32_chars

# Inventory hold duration in seconds before unpaid bookings release automatically (default: 900 = 15m)
BOOKING_HOLD_TTL_SECONDS=900

# Comma-separated list of permitted origins for browser-originated widget requests (CORS)
ALLOWED_CHATBOT_ORIGINS=http://localhost:5173,http://localhost:3000,https://chat.example.com

# Optional server-to-server bot provider authentication token (Authorization: Bearer <token>)
# If configured, requests to booking endpoints must provide this bearer token.
CHATBOT_API_SECRET=

# ------------------------------------------------------------------------------
# 6. n8n Cloud & Whinta WhatsApp Integration
# ------------------------------------------------------------------------------
# Shared bearer token used by n8n Cloud HTTP Request nodes when calling Hotel Mantri API
N8N_API_TOKEN=your_secure_random_n8n_api_token_here

# n8n Cloud Webhook URL triggered upon authoritative payment settlement
# Example: https://your-workspace.app.n8n.cloud/webhook/hotelmantri-payment-confirmed
N8N_PAYMENT_WEBHOOK_URL=

# Secret key used to sign backend-to-n8n webhook events with HMAC-SHA256 (X-HotelMantri-Signature)
N8N_WEBHOOK_SECRET=your_secure_n8n_webhook_signing_secret_here

# Whinta / WhatsApp Business Template Name for reservation confirmation
WHINTA_RESERVATION_TEMPLATE=hotel_mantri_reservation_confirmation_
